{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "promptMaxRows": 24,
  "promptFieldMaxWidth": 400,
  "reviewLogFieldMaxWidth": 1000,

  "permission": {
    "*": "ask",

    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.git-credentials": "deny"
    },
    "path_write": {
      "*": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "**/.env*": "deny"
    },

    "read": "allow",
    "write": "ask",
    "edit": "ask",

    "bash": {
      "ls *": "allow",
      "ls": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "date": "allow",
      "whoami": "allow",
      "uname *": "allow",
      "df *": "allow",
      "du *": "allow",
      "file *": "allow",
      "which *": "allow",
      "type *": "allow",
      "history": "allow",

      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "git *": "ask",

      "npm view *": "allow",
      "npm search *": "allow",
      "npm *": "ask",
      "pnpm view *": "allow",
      "pnpm search *": "allow",
      "pnpm *": "ask",
      "yarn *": "ask",
      "pip show *": "allow",
      "pip list": "allow",
      "pip *": "ask",

      "npm test *": "ask",
      "npm run build *": "ask",
      "node --check *": "allow",
      "python3 -m py_compile *": "allow",
      "python3 -m pytest *": "ask",
      "python3 -m unittest *": "ask",
      "go test *": "ask",
      "cargo check *": "ask",
      "cargo build *": "ask",
      "cargo test *": "ask",

      "rm -rf *": { "action": "deny", "reason": "禁止递归强制删除，请先确认目标再单独删除" },
      "rm -fr *": { "action": "deny", "reason": "禁止递归强制删除" },
      "rm -r -f *": { "action": "deny", "reason": "禁止递归强制删除" },
      "sudo *": "ask",
      "mkfs *": { "action": "deny", "reason": "禁止格式化磁盘" },
      "dd *": "ask",
      "shutdown *": { "action": "deny", "reason": "禁止关机" },
      "reboot": { "action": "deny", "reason": "禁止重启" },
      "chmod -R *": "ask",
      "chown *": "ask",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean -f*": "ask",
      "git checkout -f *": "ask",
      "git rebase *": "ask",
      "git stash drop *": "ask",
      "git branch -D *": "ask",
      "git tag -d *": "ask",

      "curl -s *": "allow",
      "curl -sS *": "allow",
      "curl -I *": "allow",
      "curl -i *": "ask",
      "curl -X POST *": "ask",
      "curl -X PUT *": "ask",
      "curl -X DELETE *": "ask",
      "curl -d *": "ask",
      "curl *": "ask",
      "wget -q *": "allow",
      "wget *": "ask",
      "ping *": "allow",
      "nslookup *": "allow",
      "dig *": "allow",
      "nc -z *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "tmux *": "ask",

      "ps *": "allow",
      "ps": "allow",
      "top -b -n 1 *": "allow",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",

      "cp *": "ask",
      "mv *": "ask",
      "mkdir *": "ask",
      "touch *": "ask",
      "chmod *": "ask",
      "ln -s *": "ask",
      "tar *": "ask",
      "zip *": "ask",
      "unzip *": "ask",
      "unrar *": "ask",

      "*": "ask"
    },

    "mcp": { "*": "ask" },
    "skill": { "*": "ask" },

    "external_directory": {
      "*": "ask",
      "~/.cargo/registry/*": "allow",
      "~/.cache/*": "allow",
      "~/.npm/*": "allow",
      "~/.pnpm-store/*": "allow",
      "~/.local/share/pnpm/*": "allow",
      "~/.config/*": "allow"
    },
    "external_directory_read": {
      "~/*": "allow",
      "/tmp/*": "allow"
    }
  }
}
